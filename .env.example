# claude-code-tg — Telegram bridge config
#
# Optional. Most users should run `npx claude-code-tg init` instead, which
# stores values in ~/.config/claude-code-tg/config.json. This .env file is
# only useful for development or for overriding values at runtime — env
# vars take precedence over the saved config.

# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# The single Telegram user allowed to talk to the bridge — your numeric
# chat_id (get it from @userinfobot). Anyone else's messages are ignored.
ALLOWED_CHAT_ID=

# Local port the Stop hook posts end-of-turn payloads to. Default 8765.
INTAKE_PORT=8765

# How long a single Telegram-driven turn may run before being aborted.
# Default 600 seconds.
CLAUDE_TIMEOUT_SEC=600
