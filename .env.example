# Claudesworth — Telegram bridge config
#
# Copy to .env and fill in. .env is gitignored.

# BotFather token. Inherited from the OpenClaw-era bot (@claudesworth_bot).
TELEGRAM_BOT_TOKEN=

# Single allowed Telegram user — your numeric chat_id from @userinfobot.
ALLOWED_CHAT_ID=

# Local intake port the Stop hook posts to. Default 8765.
INTAKE_PORT=8765
