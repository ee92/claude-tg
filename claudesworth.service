[Unit]
Description=Claudesworth — Telegram bridge for Claude Code
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clawd
WorkingDirectory=/home/clawd/projects/claudesworth
EnvironmentFile=/home/clawd/projects/claudesworth/.env
ExecStart=/usr/bin/node /home/clawd/projects/claudesworth/dist/index.js
Restart=always
RestartSec=5
# All logs go to journald
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
