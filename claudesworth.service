[Unit]
Description=Claudesworth — Telegram bridge for Claude Code
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clawd
WorkingDirectory=/home/clawd/projects/claudesworth
EnvironmentFile=/home/clawd/projects/claudesworth/.env
ExecStart=/home/clawd/projects/claudesworth/venv/bin/python /home/clawd/projects/claudesworth/bridge.py
Restart=always
RestartSec=5
# Stdout/stderr go to the journal; bridge.py writes its own claudesworth.log
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
